##############################################################################
################################ makefile-s ##################################
##############################################################################
#                                                                            #
#   makefile of SatelliteBlock and its dependencies, excluding SMS++         #
#                                                                            #
#   The makefile defines internally all external libraries required by       #
#   SatelliteBlock, excluding the SMS++ core ones whose symbols are          #
#   assumed to have been defined already (typically by including             #
#   SMS++/lib/makefile). Accordingly, all necessary OBJ, H, -I directives,   #
#   external libraries  + -L< libdirs > are added to the corresponding       #
#   SAT* macros.                                                             #
#                                                                            #
#   Input:  $(CC)       = compiler command                                   #
#           $(SW)       = compiler options                                   #
#           $(SMS++INC) = the -I$( core SMS++ directory )                    #
#           $(SMS++OBJ) = the core SMS++ library                             #
#           $(SATSDR) = the directory where SatelliteBlock source is         #
#                                                                            #
#   Output: $(SATOBJ) = the final object(s) / library                        #
#           $(SATLIB) = external libraries + -L< libdirs >                   #
#           $(SATH)   = the .h files to include for SatelliteBlock           #
#           $(SATINC) = the -I$( SatelliteBlock directory )                  #
#                                                                            #
#                              Luca Mencarelli                               #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

CC = clang++ -D_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION
#SW = -g3 -glldb -fno-inline -std=c++17 -ferror-limit=1
# production compiler options
SW = -O3 -DNDEBUG -std=c++17
SATSDR = .
SMS++OBJ = ../smspp/lib/libSMS++.a

# the Boost library
include ../extlib/makefile-libBoost

# the Eigen library
include ../extlib/makefile-libEigen

# the NetCDF library
include ../extlib/makefile-libNetCDF

# the CPLEX library
include ../extlib/makefile-libCPLEX

# external -I directives for the core SMS++
SMS++INC = -I ../smspp/include $(libBoostINC) $(libEigenINC) $(libNtCDFINC) $(libCPLEXINC)

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

MILPINC = $(SATSDR)/../milpsolver/include

# include the makefile requiring all external modules in input
include $(SATSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to SATINC, SATOBJ and SATH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
SATOBJ := $(SATOBJ) $(libMCFClOBJ)
SATINC := $(SATINC) $(libMCFClINC)

# external libraries for SatelliteBlock
SATLIB = $(libMCFClLIB) $(MILPINC)

########################### End of makefile-s ################################
